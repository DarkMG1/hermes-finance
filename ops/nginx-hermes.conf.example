# Public route to the Hermes server. Copy to /etc/nginx/sites-available/<your host>, replace
# hermes.example.com, enable it, then run: sudo certbot --nginx -d <your host>
# (certbot adds the TLS server block and the http->https redirect).
server {
  listen 80;
  listen [::]:80;
  server_name hermes.example.com;

  client_max_body_size 3m;

  location / {
    proxy_pass http://127.0.0.1:5010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 150s;
  }
}
